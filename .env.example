# Copy to .env for local overrides. The development stack uses loopback only.
CHAINPROOF_RPC_URL=http://127.0.0.1:8545
CHAINPROOF_CHAIN_ID=31337
CHAINPROOF_DEPLOYMENT_FILE=data/hardhat-deployment.json
CHAINPROOF_DB=data/chainproof.sqlite3
CHAINPROOF_EVIDENCE_DIR=data/evidence
CHAINPROOF_NODE=node
# Required: set two different outputs of `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
# The viewer token can read; the analyst token can read and change case data.
# CPX_API_VIEWER_TOKEN=
# CPX_API_ANALYST_TOKEN=
# Optional Python executable; defaults to the project .venv when available.
# PYTHON=.venv/bin/python
# Leave empty for local Vite development; /api/v1 and /health are proxied to FastAPI.
VITE_API_BASE_URL=
# The demo seeder is pinned to isolated competition-demo API port 8100.
