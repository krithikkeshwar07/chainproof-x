{
  "name": "chainproof-x",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:contract": "hardhat test",
    "chain:node": "hardhat node --hostname 127.0.0.1 --port 8545",
    "chain:deploy": "hardhat run scripts/deploy.cjs --network localhost",
    "test": "node --experimental-strip-types --test test/integrity.test.ts test/deployment-safety.test.cjs test/dependency-overrides.test.cjs",
    "test:frontend": "vitest run",
    "dev:stack": "node scripts/dev-stack.cjs",
    "demo:stack": "node scripts/dev-stack.cjs --demo",
    "demo:reset": "node scripts/reset-demo.cjs",
    "demo:seed": "node scripts/seed-demo.cjs",
    "chain:node:demo": "hardhat node --hostname 127.0.0.1 --port 8546",
    "rehearsal:chain": "hardhat node --hostname 127.0.0.1 --port 8556",
    "rehearsal:deploy": "node scripts/rehearsal-deploy.cjs",
    "rehearsal:app": "node scripts/rehearsal-app.cjs",
    "rehearsal:seed": "node scripts/rehearsal-seed.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hardhat": "^2.29.1",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "tmp": "^0.2.7"
  }
}
